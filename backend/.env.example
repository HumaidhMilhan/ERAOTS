# App Settings
APP_NAME="ERAOTS"
APP_VERSION="1.0.0"
DEBUG=False
SECRET_KEY=""

# Database (Use PostgreSQL in production)
DATABASE_URL="postgresql+asyncpg://user:pass@localhost:5432/eraots"

# Cache
REDIS_URL="redis://localhost:6379/0"

# JWT
JWT_SECRET_KEY=""
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS
CORS_ORIGINS="http://yourdomain.com"

# Initial Passwords
INITIAL_SUPERADMIN_PASSWORD="change_me_immeditaly"
INITIAL_HR_PASSWORD="change_me_immeditaly"
